# Copy to .env (never commit the real file).
# Optional: enables hosted Llama generation via Groq. Without it the app uses
# local Ollama if running, otherwise an offline extractive generator.
GROQ_API_KEY=

# Optional: Ollama server (default http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: server port (default 5000)
# PORT=5000
